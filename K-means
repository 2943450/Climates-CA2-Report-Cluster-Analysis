# K-MEANS CLUSTERING


from sklearn.cluster import KMeans

# Choose the number of clusters
k = 4

# Initialize the model
kmeans = KMeans(
    n_clusters=k,
    init='k-means++',
    max_iter=500,
    n_init=20,
    random_state=40
)

# Fit K-means to standardized data
kmeans.fit(scaled_data)

# Cluster labels for each grid point
kmeans_labels = kmeans.labels_

# Cluster centroids (shape: k × number_of_features)
centroids = kmeans.cluster_centers_

print("K-means cluster labels:", kmeans_labels)
print("Centroid matrix shape:", centroids.shape)

